#!/usr/bin/env sh
set -eu

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
PLUGIN_ROOT=$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd)
RELEASES_URL="https://github.com/nklisch/peeragent/releases"

# 1. Explicit override.
if [ -n "${PEERAGENT_BIN:-}" ] && [ -x "$PEERAGENT_BIN" ]; then
  exec "$PEERAGENT_BIN" "$@"
fi

# 2. Local ephemeral build (developer `make build`).
if [ -x "$PLUGIN_ROOT/dist/peeragent" ]; then
  exec "$PLUGIN_ROOT/dist/peeragent" "$@"
fi

# 3. Source checkout with Go: run current source so edits are reflected.
if [ -d "$PLUGIN_ROOT/cmd/peeragent" ] && command -v go >/dev/null 2>&1; then
  exec go run "$PLUGIN_ROOT/cmd/peeragent" "$@"
fi

# 4. Committed platform binary (marketplace / no-Go install).
detect_target() {
  # PEERAGENT_TARGET_OVERRIDE lets a user point at a present binary on a
  # misdetected platform. Accept it only as a safe <goos>-<goarch> token;
  # anything else falls back to uname detection so arbitrary text never lands
  # in the resolved path or the JSON error below.
  if [ -n "${PEERAGENT_TARGET_OVERRIDE:-}" ]; then
    case "$PEERAGENT_TARGET_OVERRIDE" in
      "" | *[!a-z0-9_-]*) : ;;
      *) printf '%s' "$PEERAGENT_TARGET_OVERRIDE"; return ;;
    esac
  fi
  case "$(uname -s 2>/dev/null || echo unknown)" in
    Linux) goos=linux ;;
    Darwin) goos=darwin ;;
    *) goos=unknown ;;
  esac
  case "$(uname -m 2>/dev/null || echo unknown)" in
    x86_64|amd64) goarch=amd64 ;;
    arm64|aarch64) goarch=arm64 ;;
    *) goarch=unknown ;;
  esac
  printf '%s-%s' "$goos" "$goarch"
}
TARGET=$(detect_target)
CANDIDATE="$PLUGIN_ROOT/bin/$TARGET/peeragent"
if [ -x "$CANDIDATE" ]; then
  exec "$CANDIDATE" "$@"
fi

# 5. No prebuilt binary for this platform — fail per the result contract (exit 3).
# Prebuilt binaries cover linux/darwin on amd64/arm64 only; other platforms build
# from source. JSON goes to stdout (matching the Go binary); --text writes guidance
# to stderr. TARGET is constrained to [a-z0-9_-]; CANDIDATE is JSON-escaped.
json_escape() {
  printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'
}
wants_text() {
  for a in "$@"; do
    [ "$a" = "--text" ] && return 0
  done
  return 1
}
if wants_text "$@"; then
  printf 'peeragent has no prebuilt binary for this platform (%s).\nPrebuilt binaries cover linux and macOS on amd64/arm64.\nOn other platforms, build from source (requires Go):\n  go build -o <path>/peeragent ./cmd/peeragent\nthen set PEERAGENT_BIN=<path>/peeragent (or place it at %s).\nReleases: %s\n' \
    "$TARGET" "$CANDIDATE" "$RELEASES_URL" >&2
else
  details="No prebuilt peeragent binary for $TARGET. Prebuilt binaries cover linux/darwin on amd64/arm64; on other platforms build from source with Go (go build -o PATH ./cmd/peeragent) and set PEERAGENT_BIN=PATH, or place the binary at $(json_escape "$CANDIDATE"). Releases: $RELEASES_URL"
  printf '{"status":"failed","summary":"peeragent has no prebuilt binary for %s","changed_files":[],"verification":[],"details":"%s","metadata":{"exit_code":3,"target":"%s"}}\n' \
    "$TARGET" "$details" "$TARGET"
fi
exit 3
