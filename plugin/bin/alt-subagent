#!/usr/bin/env sh
set -eu

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
PLUGIN_ROOT=$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd)

if [ -n "${ALT_SUBAGENT_BIN:-}" ] && [ -x "$ALT_SUBAGENT_BIN" ]; then
  exec "$ALT_SUBAGENT_BIN" "$@"
fi

if [ -x "$PLUGIN_ROOT/dist/alt-subagent" ]; then
  exec "$PLUGIN_ROOT/dist/alt-subagent" "$@"
fi

version_from_manifest() {
  for manifest in "$PLUGIN_ROOT/.claude-plugin/plugin.json" "$PLUGIN_ROOT/.codex-plugin/plugin.json"; do
    if [ -f "$manifest" ]; then
      awk -F'\"' '/\"version\"[[:space:]]*:/ { print $4; exit }' "$manifest"
      return 0
    fi
  done
}

run_from_source() {
  if command -v go >/dev/null 2>&1 && [ -d "$PLUGIN_ROOT/cmd/alt-subagent" ]; then
    exec go run "$PLUGIN_ROOT/cmd/alt-subagent" "$@"
  fi
}

# In a source checkout, prefer local Go execution so development does not depend
# on a published release existing for the current manifest version.
if [ -d "$PLUGIN_ROOT/.git" ]; then
  run_from_source "$@"
fi

VERSION=${ALT_SUBAGENT_VERSION:-$(version_from_manifest || true)}
VERSION=${VERSION%%+*}

UNAME_S=$(uname -s 2>/dev/null || echo unknown)
UNAME_M=$(uname -m 2>/dev/null || echo unknown)
case "$UNAME_S" in
  Linux) GOOS=linux ;;
  Darwin) GOOS=darwin ;;
  *) GOOS=unknown ;;
esac
case "$UNAME_M" in
  x86_64|amd64) GOARCH=amd64 ;;
  arm64|aarch64) GOARCH=arm64 ;;
  *) GOARCH=unknown ;;
esac

CACHE_BASE=${ALT_SUBAGENT_CACHE_DIR:-${XDG_CACHE_HOME:-$HOME/.cache}/alt-subagent}
CACHE_BIN="$CACHE_BASE/v$VERSION/$GOOS-$GOARCH/alt-subagent"

if [ -n "$VERSION" ] && [ -x "$CACHE_BIN" ]; then
  exec "$CACHE_BIN" "$@"
fi

if [ "${ALT_SUBAGENT_SKIP_DOWNLOAD:-}" != "1" ] && [ -n "$VERSION" ] && [ "$GOOS" != unknown ] && [ "$GOARCH" != unknown ] && command -v curl >/dev/null 2>&1 && command -v tar >/dev/null 2>&1 && command -v mktemp >/dev/null 2>&1; then
  ASSET="alt-subagent_${VERSION}_${GOOS}_${GOARCH}.tar.gz"
  BASE_URL=${ALT_SUBAGENT_RELEASE_BASE:-https://github.com/nklisch/alt-subagent/releases/download/v$VERSION}
  TMPDIR=$(mktemp -d 2>/dev/null || mktemp -d -t alt-subagent)
  cleanup() { rm -rf "$TMPDIR"; }
  trap cleanup EXIT INT TERM
  if curl -fsSL "$BASE_URL/$ASSET" -o "$TMPDIR/$ASSET" && tar -xzf "$TMPDIR/$ASSET" -C "$TMPDIR"; then
    mkdir -p "$(dirname "$CACHE_BIN")"
    cp "$TMPDIR/alt-subagent" "$CACHE_BIN"
    chmod +x "$CACHE_BIN"
    exec "$CACHE_BIN" "$@"
  fi
fi

run_from_source "$@"

cat >&2 <<EOF
alt-subagent executable is not available.

Install Go and run 'make build' from the plugin source, or install a release
asset for this platform. The wrapper looked for:

  $PLUGIN_ROOT/dist/alt-subagent
  $CACHE_BIN

Set ALT_SUBAGENT_BIN to an executable path to override discovery.
EOF
exit 127
